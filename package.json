{
  "name": "wacta-scoring",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB --local",
    "db:local": "wrangler d1 execute wacta-scoring --local --file=./migrations/0002_full_league.sql",
    "db:remote": "wrangler d1 execute wacta-scoring --remote --file=./migrations/0002_full_league.sql",
    "db:migrate": "wrangler d1 execute wacta-scoring --remote --file=./migrations/0006_activity_details.sql",
    "deploy": "wrangler pages deploy public",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.0",
    "jose": "^6.0.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.99.0"
  }
}
